# =============================================================================
# 字相 Agent 配置示例
# 复制为 .env 并按需修改。所有变量都有默认值（OpenAI 官方），
# 只需填 OPENAI_API_KEY 即可运行；要切第三方服务商时再改下面的变量。
# =============================================================================

# ---- 必填：API Key（共享默认值，三个端点都用它）----
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ---- 可选：共享服务商配置（对所有端点生效，可被分端点变量覆盖）----
# API 基础地址，应包含版本路径
# API_BASE_URL=https://api.openai.com/v1
# 认证方式：bearer | header | query
# AUTH_STYLE=bearer
# AUTH_STYLE=header 时使用的请求头名
# AUTH_HEADER_NAME=Authorization
# AUTH_STYLE=query 时使用的 query 参数名
# AUTH_QUERY_PARAM=api_key
# 额外请求头，格式 K1:V1;K2:V2（如 OpenRouter 的 HTTP-Referer / X-Title）
# EXTRA_HEADERS=HTTP-Referer:https://myapp.com;X-Title:字相Agent
# 图片响应格式：url | b64 | auto（仅图片端点有意义）
# IMAGE_RESPONSE_FORMAT=auto

# ---- 可选：模型名 ----
# VISION_MODEL=gpt-4o
# TEXT_MODEL=gpt-4o-mini
# IMAGE_MODEL=dall-e-3

# ---- 可选：分端点覆盖（只覆盖你需要的字段）----
# 端点前缀：VISION_ / TEXT_ / IMAGE_
# 对应字段：API_BASE_URL / API_KEY / AUTH_STYLE / AUTH_HEADER_NAME /
#           AUTH_QUERY_PARAM / EXTRA_HEADERS / RESPONSE_FORMAT

# 例1：视觉走 OpenAI，图片生成走米醋 API（query 认证、返回 base64）
# VISION_MODEL=gpt-4o
# IMAGE_API_BASE_URL=https://api.micuai.cn/v1
# IMAGE_API_KEY=mc-xxxxxxxx
# IMAGE_AUTH_STYLE=query
# IMAGE_AUTH_QUERY_PARAM=apikey
# IMAGE_RESPONSE_FORMAT=b64
# IMAGE_MODEL=dall-e-3

# 例2：全部走 API2D（OpenAI 兼容中转，Bearer 认证）
# API_BASE_URL=https://oa.api2d.net/v1
# OPENAI_API_KEY=xxxxxxxx

# 例3：全部走 OpenRouter（需带额外请求头，仅支持文本/视觉，不支持画图）
# API_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-xxx
# EXTRA_HEADERS=HTTP-Referer:https://myapp.com;X-Title:字相Agent
# VISION_MODEL=openai/gpt-4o
# TEXT_MODEL=openai/gpt-4o-mini
